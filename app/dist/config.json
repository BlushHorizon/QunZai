{
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "qq": {
    "mode": "onebot",
    "onebot": {
      "wsUrl": "ws://127.0.0.1:3001",
      "accessToken": ""
    },
    "official": {
      "appId": "",
      "clientSecret": "",
      "sandbox": false
    },
    "engine": {
      "enabled": true,
      "autoStart": true,
      "source": "auto",
      "dir": "",
      "account": "",
      "apiPort": 3000
    }
  },
  "ai": {
    "enabled": true,
    "provider": "deepseek-web",
    "cdpPort": 9222,
    "browserPath": "",
    "webPrompt": "",
    "webMaxRounds": 50,
    "baseUrl": "https://api.deepseek.com",
    "apiKey": "",
    "model": "deepseek-chat",
    "systemPrompt": "你是「网页版 QQ 助手」，正在通过 QQ 与好友聊天。要求：中文回复、简洁自然、不要用 Markdown 语法、不要自称 AI 模型、长度控制在 100 字以内。",
    "scope": "all",
    "replyMode": "all",
    "targetChatKey": "",
    "targetChatKeys": [],
    "requireMentionInGroup": false,
    "groupReplyChance": 100,
    "groupKeywords": "",
    "quietEnabled": false,
    "quietFrom": "23:00",
    "quietTo": "08:00",
    "commandSenders": "",
    "imageReply": true,
    "groupAtSender": true,
    "groupQuote": true,
    "minIntervalMs": 2500,
    "historyTurns": 8,
    "replyDelayMs": 900
  },
  "interest": {
    "enabled": true,
    "capabilities": [
      "编程",
      "电脑",
      "游戏",
      "番剧",
      "学习",
      "做饭",
      "数码"
    ],
    "interjectThreshold": 0.55,
    "initiateThreshold": 0.65,
    "judge": "lexical",
    "profileDecayPerDay": 0.02
  },
  "interestReply": {
    "enabled": false,
    "shadow": true,
    "threshold": 0.55
  },
  "proactive": {
    "enabled": false,
    "shadow": true,
    "idleMin": 25,
    "minGroupMsgsToday": 20,
    "nightFrom": "00:00",
    "nightTo": "09:00",
    "maxPerHour": 2,
    "maxPerDay": 8,
    "minGapMs": 1200000,
    "ignoreWindowSec": 600,
    "settleMs": 3000,
    "targetChatKeys": [],
    "candidateKinds": [
      "event",
      "meme",
      "fact"
    ]
  },
  "moderation": {
    "enabled": false,
    "shadow": false,
    "autoPunish": false,
    "whitelistUsers": "",
    "whitelistChats": "",
    "spam": {
      "enabled": true,
      "windowSec": 10,
      "maxMsgs": 6,
      "strikesDecayMin": 10,
      "muteMin": 5
    },
    "ad": {
      "enabled": true,
      "deleteMsg": true,
      "blockLinks": false
    },
    "banned": {
      "enabled": true,
      "words": "色情,裸聊,约炮,赌博,博彩,网赌,毒品,冰毒,枪支,代开发票,办证,洗钱,诈骗,刷单,裸条",
      "deleteMsg": false,
      "notifyAdmin": true
    },
    "duplicate": {
      "enabled": true,
      "windowSec": 60,
      "times": 3,
      "minChars": 6,
      "notice": true,
      "deleteMsg": true
    },
    "welcome": {
      "enabled": true,
      "text": "欢迎 {name} 加入本群 👋 群公告里有规则，有问题直接问就好。",
      "delaySec": 2
    },
    "curfew": {
      "enabled": true,
      "from": "00:00",
      "to": "06:00",
      "text": "夜深了，{name} 早点睡吧，明天再聊 🌙",
      "maxPerNight": 3,
      "gapMin": 30
    }
  },
  "update": {
    "manifestUrl": "https://blushhorizon.github.io/QunZai/update.json",
    "autoCheck": true
  }
}